# LLM 网关（OpenAI 兼容接口）。复制为 .env 并填入真实 key；.env 不入仓库。
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL_PLANNER=mimo-v2.6-pro
LLM_MODEL_LIGHT=mimo-v2.6-flash

# 服务端口
PORT=3210

# 数据源：mock = 构造数据（显式标注）；fuyao/ifind = 真实数据源（需另行申请 key，未启用）
DATA_PROVIDER=mock

# 扶摇（同花顺金融数据 API）数据源。DATA_PROVIDER=fuyao 时启用；key 仅本地 .env，不入仓库/记忆。
FUYAO_API_KEY=
FUYAO_BASE_URL=https://fuyao.aicubes.cn
# 可选：设为 1 时，仅 network/timeout/2001/5xx 失败允许回退 mock（显式标注"非真实行情"）；
# 默认关闭=一律诚实缺失（3001/3002/3004/2003/2004 等绝不回退、绝不编数）。
FUYAO_FALLBACK_MOCK=
